{
  "compilerOptions": {
    "target": "es2016",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "outDir": "./dist",
    "rootDir": "./src",
  },
}
